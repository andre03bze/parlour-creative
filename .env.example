# Public site URL — canonical URLs, hreflang, OG, sitemap, structured data. Final domain not chosen yet: the temporary
# Vercel project sets it to its own URL. Set it (https, no trailing slash) to the launch domain when that exists.
# NEXT_PUBLIC_SITE_URL=

# Indexing is BLOCKED unless this is 1 (build-time): noindex meta + X-Robots-Tag + robots Disallow + empty sitemap.
# Set only for the final launch domain. Never on temporary/preview deployments.
# NEXT_PUBLIC_ALLOW_INDEXING=1

# Social channels (https URLs only). All four icons always show; Instagram/Facebook/LinkedIn are inactive until their URL is set.
# NEXT_PUBLIC_SOCIAL_INSTAGRAM=
# NEXT_PUBLIC_SOCIAL_FACEBOOK=
# NEXT_PUBLIC_SOCIAL_LINKEDIN=

# Development-only tooling. Leave unset (or 0) in production.
# NEXT_PUBLIC_SHOW_PALETTES=1   # show the palette review switcher
# NEXT_PUBLIC_SHOW_LAB=1        # serve the /lab prototype routes (they stay noindex)

# Contact delivery — NOT connected yet. Until src/lib/deliver-enquiry.ts is implemented, /api/contact answers
# 503 "delivery_not_configured" and the form tells the visitor plainly that nothing was sent.
# When a provider is chosen, add its key here (server-side only, never NEXT_PUBLIC_) and set
# NEXT_PUBLIC_CONTACT_DELIVERY=ready to remove the on-page notice.
# NEXT_PUBLIC_CONTACT_DELIVERY=ready
# CONTACT_NOTIFY_EMAIL=laura@parlourcreative.ca
# RESEND_API_KEY=
