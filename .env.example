# Site
NEXT_PUBLIC_SITE_URL=https://parlourcreative.ca

# Analytics — not yet issued (see CONTENT-GAPS.md). Leave blank in development;
# analytics components no-op when unset rather than sending malformed requests.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Contact form delivery — leave unset in development; the contact API route logs
# submissions instead of sending when this is empty. Set for production once an
# email/CRM provider is chosen.
CONTACT_NOTIFY_EMAIL=laura@parlourcreative.ca
RESEND_API_KEY=
